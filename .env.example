# Unconfigured builds stay in the fictional demo. Never add real beta credentials
# to unprotected public previews. Set beta vars only for the approved private site.
VITE_APP_MODE=demo
# VITE_SUPABASE_URL=https://YOUR_BETA_PROJECT.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Never place a service-role/secret key in a VITE_ variable.
