{
  "name": "citizen-groups",
  "private": true,
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "build": "node scripts/build.cjs",
    "dev": "python3 -m http.server 8000",
    "test:browser": "npm run build && node scripts/phase1-browser-check.mjs",
    "test:onboarding": "npm run build && node scripts/onboarding-browser-check.mjs",
    "pilot:check": "node scripts/check-pilot-readiness.cjs",
    "test:blank-battle": "npm run build && node scripts/blank-battle-browser-check.mjs",
    "test:groups-safety": "npm run build && node scripts/groups-safety-browser-check.mjs",
    "test:chat-lab": "npm run build && node scripts/chat-lab-browser-check.mjs",
    "test:groups-integrated": "npm run build && node scripts/groups-integrated-browser-check.mjs",
    "test:verseplay": "node --test verseplay/tests/*.test.js",
    "test:verseplay:browser": "node verseplay/tests/verse-circuit.browser.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "jsdom": "^26.1.0",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0"
  }
}
